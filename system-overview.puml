@startuml SystemOverview
title Auction System - Presentation Overview

left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam nodesep 70
skinparam ranksep 85
hide members

actor "User" as User

package "Client Application\n(JavaFX + MVC)" as Client {
  [FXML Views] as Views
  [Controllers] as Controllers
  [Presenters / Renderers] as Presenters
  [Client Service] as ClientService
  [Client Socket] as ClientSocket
  [Response Router] as ClientRouter
}

package "Common Layer\n(Shared Contract)" as Common {
  [Message DTO] as Message
  [Domain Models] as Models
  [Role Policy] as RolePolicy
}

package "Server Application\n(Socket + Business Logic)" as Server {
  [AuctionServer] as AuctionServer
  [ClientHandler] as ClientHandler
  [Action Router] as ActionRouter
  [Action Handlers] as ActionHandlers
  [Business Services] as Services
}

database "MySQL Database" as Database

User --> Views : uses
Views --> Controllers : events
Controllers --> Presenters : update UI
Controllers --> ClientService : request actions
ClientService --> ClientSocket : send Message
ClientSocket --> ClientRouter : receive Message
ClientRouter --> Controllers : dispatch response

ClientSocket <--> ClientHandler : socket protocol
ClientHandler --> ActionRouter : route action
ActionRouter --> ActionHandlers : choose handler
ActionHandlers --> Services : execute use case
Services --> Database : read / write

Client ..> Common : uses DTO/model
Server ..> Common : uses DTO/model
Services ..> Models : business state
ClientService ..> Message : creates request
ClientRouter ..> Message : routes response
@enduml
