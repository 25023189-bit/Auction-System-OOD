<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" styleClass="main-container" stylesheets="@../css/seller-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.SellerController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label styleClass="orange-text-bold" text="Seller Dashboard">
                            <font><Font size="24.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblReputation" styleClass="reputation-label" text="Reputation: 5.0 Stars" />
                    </children>
                </HBox>

                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="10.0" styleClass="glass-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="orange-text-small" text="Auction Item Name:" />
                                <TextField fx:id="txtItemName" promptText="Item name" styleClass="glass-input" />

                                <Label styleClass="orange-text-small" text="Description:" />
                                <TextArea fx:id="txtItemDescription" prefRowCount="5" promptText="Detailed item description..." styleClass="glass-input" wrapText="true" />

                                <Label styleClass="orange-text-small" text="Starting Price ($):" />
                                <TextField fx:id="txtStartingPrice" promptText="Example: 1000" styleClass="glass-input" />
                            </children>
                        </VBox>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="10.0" styleClass="glass-card">
                                    <children>
                                        <Label styleClass="orange-text-small" text="Minimum Join Amount ($):" />
                                        <TextField fx:id="txtMinimumJoinAmount" styleClass="glass-input" />
                                        <Label styleClass="orange-text-small" text="Bid Step ($):" />
                                        <TextField fx:id="txtBidStep" styleClass="glass-input" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="glass-card">
                                    <children>
                                        <Label styleClass="orange-text-small" text="Start Time:" />
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <children>
                                                <DatePicker fx:id="datePickerStart" prefWidth="130.0" styleClass="glass-input" />
                                                <TextField fx:id="txtStartHour" prefWidth="60.0" promptText="HH" styleClass="glass-input" />
                                                <Label styleClass="orange-text-bold" text=":" />
                                                <TextField fx:id="txtStartMinute" prefWidth="60.0" promptText="MM" styleClass="glass-input" />
                                            </children>
                                        </HBox>

                                        <HBox spacing="20.0">
                                            <children>
                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="orange-text-small" text="Duration (Min):" />
                                                        <TextField fx:id="txtDuration" styleClass="glass-input" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="orange-text-small" text="Extension (Sec):" />
                                                        <TextField fx:id="txtExtensionSeconds" styleClass="glass-input" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Label fx:id="lblStatus" textFill="RED" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleCreateAuction" prefHeight="45.0" prefWidth="200.0" styleClass="btn-create-orange" text="Create Auction" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
