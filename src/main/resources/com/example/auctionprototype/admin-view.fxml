<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AdminController">

    <top>
        <HBox alignment="CENTER" styleClass="admin-header">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="HỆ THỐNG QUẢN TRỊ - ADMIN DASHBOARD" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Quản lý Người dùng">
                    <VBox spacing="10.0">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#loadUsers" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Làm mới danh sách" />
                            <Button mnemonicParsing="false" onAction="#handleDeleteUser" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Xóa tài khoản" />
                        </HBox>

                        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="150.0" text="Mã Khách Hàng" />
                                <TableColumn fx:id="colUsername" prefWidth="200.0" text="Tên Tài Khoản" />
                                <TableColumn fx:id="colRole" prefWidth="150.0" text="Vai Trò" />
                                <TableColumn fx:id="colBalance" prefWidth="200.0" text="Số Dư ($)" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Quản lý Phiên đấu giá">
                    <VBox spacing="10.0">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#loadAuctions" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Làm mới danh sách" />
                            <Button mnemonicParsing="false" onAction="#handleForceDeleteAuction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Ép hủy phiên" />
                        </HBox>

                        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRoomId" prefWidth="120.0" text="Mã Phòng" />
                                <TableColumn fx:id="colRoomName" prefWidth="250.0" text="Tên Vật Phẩm" />
                                <TableColumn fx:id="colSeller" prefWidth="150.0" text="Người Bán" />
                                <TableColumn fx:id="colPrice" prefWidth="150.0" text="Giá Hiện Tại ($)" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Trạng Thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Quản lý Giao dịch Người dùng">
                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Lịch Sử Đặt Giá" />

                        <TableView fx:id="tableBidHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBidAuctionId" prefWidth="120.0" text="Mã Phòng" />
                                <TableColumn fx:id="colBidderId" prefWidth="150.0" text="Người Đặt (Bidder)" />
                                <TableColumn fx:id="colBidAmount" prefWidth="150.0" text="Mức Giá ($)" />
                                <TableColumn fx:id="colBidTime" prefWidth="150.0" text="Thời Gian Đặt" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>
