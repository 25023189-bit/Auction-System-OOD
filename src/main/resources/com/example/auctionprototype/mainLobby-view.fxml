<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controllers.AuctionController">
    <children>
        <BorderPane fx:id="paneMainLobby"
                    AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    style="-fx-background-color: #f4f7f6;">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #2C3E50; -fx-padding: 10 18 10 18;">
                    <Label text="Sảnh Chính"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblBalance"
                           text="Số dư: 0 $"
                           style="-fx-text-fill: #F1C40F; -fx-font-weight: bold;" />
                    <Label fx:id="lblUsername"
                           text="Xin chào!"
                           textFill="WHITE" />
                    <Button text="Đăng xuất" onAction="#handleLogout"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white;" />
                </HBox>
            </top>

            <center>
                <HBox spacing="16" style="-fx-padding: 16;">
                    <VBox spacing="10" prefWidth="220"
                          style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="📈 Tỷ giá" style="-fx-font-weight: bold;" />
                        <Separator />
                        <VBox fx:id="vboxCurrencyRates" spacing="8">
                            <Label text="VND: 25.450 ₫" />
                            <Label text="EUR: 0.92 €" />
                        </VBox>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-padding: 14;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="🔥 Phiên đấu giá"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnCreateAuction"
                                    text="+ Tạo phòng"
                                    onAction="#openSellerDashboard"
                                    style="-fx-background-color: #27AE60; -fx-text-fill: white;" />
                        </HBox>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="paneSelectAuction" hgap="14" vgap="14" style="-fx-padding: 4;" />
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="10" prefWidth="220"
                          style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="📰 Tin tức" style="-fx-font-weight: bold;" />
                        <Separator />
                        <VBox fx:id="vboxNews" spacing="10">
                            <Label text="• Hệ thống cập nhật bản mới" wrapText="true" />
                            <Label text="• Theo dõi các phiên nổi bật" wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </center>

        </BorderPane>
    </children>
</AnchorPane>