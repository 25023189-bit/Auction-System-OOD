<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="chatbotRoot" prefHeight="520.0" prefWidth="360.0" pickOnBounds="false" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.ChatbotController">
    <children>
        <VBox fx:id="chatbotPanel" alignment="TOP_CENTER" disable="true" managed="false" maxHeight="460.0" maxWidth="340.0" mouseTransparent="true" spacing="0" styleClass="chatbot-panel" visible="false" StackPane.alignment="BOTTOM_RIGHT">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chatbot-header">
                    <children>
                        <Label text="Auction Assistant" styleClass="chatbot-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCloseChatbot" text="x" styleClass="chatbot-close-button" />
                    </children>
                </HBox>
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="chatbot-scroll">
                    <content>
                        <VBox fx:id="chatMessages" spacing="8" styleClass="chatbot-messages" />
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" spacing="8" styleClass="chatbot-input-bar">
                    <children>
                        <TextField fx:id="txtChatbotInput" promptText="Nhap tin nhan..." HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSendChatbot" text="Gửi" styleClass="chatbot-send-button" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <Button fx:id="btnOpenChatbot" text="Chat" styleClass="chatbot-open-button" StackPane.alignment="BOTTOM_RIGHT" />
    </children>
</StackPane>
