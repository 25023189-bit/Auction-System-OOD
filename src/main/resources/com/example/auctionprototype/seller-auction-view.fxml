<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f7fa;" stylesheets="@seller-auction-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AuctionController">
    <children>
        <BorderPane fx:id="paneAuctionRoom" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header-bar">
                    <children>
                        <Label text="HỆ THỐNG QUẢN LÝ - PHÒNG ĐẤU GIÁ (SELLER)" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER" spacing="8" styleClass="header-timer">
                                    <children>
                                        <Label style="-fx-font-size: 20px;" text="⏱" textFill="#e74c3c" />
                                        <Label fx:id="lblCountdown" text="05:00" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="22.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <VBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Label fx:id="lblUsername" style="-fx-font-weight: bold;" text="Người bán: Adam" textFill="WHITE" />
                                        <Label style="-fx-font-size: 10px;" text="Đang hoạt động" textFill="#2ecc71" />
                                    </children>
                                </VBox>

                                <Button mnemonicParsing="false" styleClass="exit-button" text="Rời Phòng" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="25.0" right="25.0" />
                    </padding>
                </HBox>
            </top>

            <center>
                <HBox spacing="25.0" style="-fx-padding: 15 25 20 25;">
                    <children>

                        <VBox prefWidth="400.0" spacing="15.0" styleClass="info-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 18px;" text="Thông tin sản phẩm" textFill="#2c3e50" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Separator prefWidth="200.0" />
                                <ImageView fx:id="imgProduct" fitHeight="250.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="true" />

                                <Label fx:id="lblProductName" text="Tên sản phẩm: Tivi 4K" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>

                                <Label fx:id="lblDescription" text="Mô tả: Màn hình siêu nét, âm thanh sống động..." textFill="#7f8c8d" wrapText="true" />

                                <Region VBox.vgrow="ALWAYS" />

                                <VBox spacing="10.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #fdf2e9; -fx-padding: 15; -fx-background-radius: 10;">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="Giá hiện tại:" />
                                                <Label fx:id="lblCurrentPrice" text="1.500.000 VNĐ" textFill="#e67e22">
                                                    <font>
                                                        <Font name="System Bold" size="26.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <Button fx:id="btnPlaceBid" minWidth="120.0" onAction="#handleBid" prefHeight="45.0" prefWidth="360.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 16;" text="CHẤP NHẬN GIÁ" />
                                        <Button fx:id="btnEndAuction" minWidth="120.0" onAction="#handleCloseAuction" prefHeight="40.0" prefWidth="360.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" text="KẾT THÚC ĐẤU GIÁ" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" styleClass="chat-container" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Lịch sử đấu giá &amp; Trò chuyện" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="txtChatLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />

                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="txtChatInput" prefHeight="45.0" promptText="Nhập tin nhắn..." HBox.hgrow="ALWAYS" />
                                        <Button minWidth="120.0" onAction="#handleSendChat" prefHeight="45.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;" text="GỬI CHAT" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>

        </BorderPane>
    </children>
</AnchorPane>
