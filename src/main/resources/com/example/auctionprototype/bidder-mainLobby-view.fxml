<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AuctionController">
    <children>
        <BorderPane fx:id="paneMainLobby" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" style="-fx-background-color: #f4f7f6;">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #2C3E50; -fx-padding: 10 18 10 18;">
                    <Label text="Bidder Lobby" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblBalance" text="Balance: 0 $" style="-fx-text-fill: #F1C40F; -fx-font-weight: bold;" />
                    <Label fx:id="lblUsername" text="Welcome!" textFill="WHITE" />
                    <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" />
                </HBox>
            </top>
            <center>
                <HBox spacing="16" style="-fx-padding: 16;">
                    <VBox spacing="10" prefWidth="285" style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="Exchange Rates" style="-fx-font-weight: bold;" />
                        <Label text="Base: 1 USD" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                        <Separator />
                        <VBox fx:id="vboxCurrencyRates" spacing="8">
                            <Label text="United States (USD): 1.00" />
                            <Label text="China (CNY): 6.82" />
                            <Label text="Japan (JPY): 158.91" />
                            <Label text="Germany (EUR): 0.85" />
                            <Label text="India (INR): 93.07" />
                            <Label text="United Kingdom (GBP): 0.74" />
                            <Label text="France (EUR): 0.85" />
                            <Label text="Brazil (BRL): 4.98" />
                            <Label text="Italy (EUR): 0.85" />
                            <Label text="Canada (CAD): 1.37" />
                            <Label text="Indonesia (IDR): 17,129.60" />
                            <Label text="Vietnam (VND): 26,336.30" />
                        </VBox>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 14;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Available Auctions" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="paneSelectAuction" hgap="14" vgap="14" style="-fx-padding: 4;" />
                            </content>
                        </ScrollPane>
                    </VBox>
                    <VBox spacing="10" prefWidth="220" style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="Bidder Notes" style="-fx-font-weight: bold;" />
                        <Separator />
                        <VBox fx:id="vboxNews" spacing="10">
                            <Label text="Join an approved auction to place bids." wrapText="true" />
                            <Label text="Check minimum balance requirements before joining." wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
        <fx:include fx:id="chatbot" source="chatbot-view.fxml" AnchorPane.rightAnchor="18.0" AnchorPane.bottomAnchor="18.0" />
    </children>
</AnchorPane>
