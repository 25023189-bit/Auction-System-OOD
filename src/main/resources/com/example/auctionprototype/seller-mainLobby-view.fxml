<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<AnchorPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AuctionController">
    <children>
        <BorderPane fx:id="paneMainLobby" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" style="-fx-background-color: #f4f7f6;">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #2C3E50; -fx-padding: 10 18 10 18;">
                    <Label text="Seller Lobby" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblBalance" text="Balance: 0 $" style="-fx-text-fill: #F1C40F; -fx-font-weight: bold;" />
                    <Label fx:id="lblUsername" text="Welcome!" textFill="WHITE" />
                    <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" />
                </HBox>
            </top>
            <center>
                <HBox spacing="16" style="-fx-padding: 16;">
                    <VBox spacing="10" prefWidth="285" style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="Exchange Rates" style="-fx-font-weight: bold;" />
                        <Label text="Base: 1 USD" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                        <Separator />
                        <VBox fx:id="vboxCurrencyRates" spacing="8">
                            <Label text="United States (USD): 1.00" />
                            <Label text="China (CNY): 6.82" />
                            <Label text="Japan (JPY): 158.91" />
                            <Label text="Germany (EUR): 0.85" />
                            <Label text="India (INR): 93.07" />
                            <Label text="United Kingdom (GBP): 0.74" />
                            <Label text="France (EUR): 0.85" />
                            <Label text="Brazil (BRL): 4.98" />
                            <Label text="Italy (EUR): 0.85" />
                            <Label text="Canada (CAD): 1.37" />
                            <Label text="Indonesia (IDR): 17,129.60" />
                            <Label text="Vietnam (VND): 26,336.30" />
                        </VBox>
                    </VBox>
                    <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 14;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Seller Auction Sessions" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />

                            <Button fx:id="btnCreateAuction" text="+ Create Auction" onAction="#openSellerDashboard" style="-fx-background-color: #27AE60; -fx-text-fill: white;" />
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="paneSelectAuction" hgap="14" vgap="14" style="-fx-padding: 4;" />
                            </content>
                        </ScrollPane>
                    </VBox>
                    <VBox spacing="10" prefWidth="220" style="-fx-background-color: white; -fx-padding: 14;">
                        <Label text="Seller Notes" style="-fx-font-weight: bold;" />
                        <Separator />
                        <VBox fx:id="vboxNews" spacing="10">
                            <Label text="Create auctions from this dashboard." wrapText="true" />
                            <Label text="Approved auctions will appear in the lobby." wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
        <StackPane fx:id="chatbotRoot" prefHeight="520.0" prefWidth="360.0" pickOnBounds="false" AnchorPane.rightAnchor="18.0" AnchorPane.bottomAnchor="18.0">
            <children>
                <VBox fx:id="chatbotPanel" alignment="TOP_CENTER" disable="true" managed="false" maxHeight="460.0" maxWidth="340.0" mouseTransparent="true" spacing="0" styleClass="chatbot-panel" visible="false" StackPane.alignment="BOTTOM_RIGHT">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chatbot-header">
                            <children>
                                <Label text="Auction Assistant" styleClass="chatbot-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnCloseChatbot" text="x" styleClass="chatbot-close-button" />
                            </children>
                        </HBox>
                        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="chatbot-scroll">
                            <content>
                                <VBox fx:id="chatMessages" spacing="8" styleClass="chatbot-messages" />
                            </content>
                        </ScrollPane>
                        <HBox alignment="CENTER" spacing="8" styleClass="chatbot-input-bar">
                            <children>
                                <TextField fx:id="txtChatbotInput" promptText="Nhap tin nhan..." HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnSendChatbot" text="Gửi" styleClass="chatbot-send-button" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Button fx:id="btnOpenChatbot" mnemonicParsing="false" prefHeight="56.0" prefWidth="56.0" styleClass="chatbot-open-button" StackPane.alignment="BOTTOM_RIGHT">
                    <graphic>
                        <SVGPath content="M4 4 H20 Q22 4 22 6 V15 Q22 17 20 17 H10 L5 21 V17 H4 Q2 17 2 15 V6 Q2 4 4 4 Z M6 8 H18 V10 H6 Z M6 12 H14 V14 H6 Z" styleClass="chatbot-open-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Mở trợ lý đấu giá" />
                    </tooltip>
                </Button>
            </children>
        </StackPane>
    </children>
</AnchorPane>
