<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.SellerController">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="500.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="BẢNG ĐIỀU KHIỂN NGƯỜI BÁN" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 0 0 10 0;">
                    <children>
                        <Label fx:id="lblReputation" text="Uy tín: 5.0 ⭐" textFill="#e67e22">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 5;">
                    <children>
                        <Label text="Tên vật phẩm đấu giá:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtItemName" promptText="Tên Sản phẩm" />
                        <TextArea fx:id="txtItemDescription" promptText="Mô tả chi tiết vật phẩm..." prefRowCount="3" wrapText="true" />

                        <Label text="Giá khởi điểm ($):">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtStartingPrice" promptText="Ví dụ: 1000" />
                    </children>
                </VBox>

                <Label fx:id="lblStatus" textFill="RED" />

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCreateAuction" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150;" text="Tạo Phiên Đấu Giá" />
                    </children>
                </HBox>

                <VBox spacing="5" style="-fx-padding: 10 0 10 0;">
                    <Label text="Thời gian bắt đầu:" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <DatePicker fx:id="datePickerStart" promptText="Chọn ngày bắt đầu" prefWidth="150"/>
                        <TextField fx:id="txtStartHour" promptText="Giờ (0-23)" prefWidth="80"/>
                        <Label text=":" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtStartMinute" promptText="Phút (0-59)" prefWidth="80"/>
                    </HBox>
                </VBox>

                <VBox spacing="5" style="-fx-padding: 0 0 10 0;">
                    <Label text="Thời gian diễn ra (Phút):" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDuration" promptText="Ví dụ: 30" prefWidth="150"/>
                    <Label text="Gia hạn mỗi lần (giây):" />
                    <TextField fx:id="txtExtensionSeconds"
                               promptText="1 - 120"/>
                </VBox>

            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>