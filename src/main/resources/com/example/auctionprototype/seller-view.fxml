<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.SellerController">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="500.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="BẢNG ĐIỀU KHIỂN NGƯỜI BÁN" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 0 0 10 0;">
                    <children>
                        <Label fx:id="lblBalance" text="Số dư ví: 0 VNĐ" textFill="#27ae60">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblReputation" text="Uy tín: 5.0 ⭐" textFill="#e67e22">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 5;">
                    <children>
                        <Label text="Tên vật phẩm đấu giá:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtItemName" promptText="Ví dụ: Siêu xe Ferrari..." />
                        <TextArea fx:id="txtItemDescription" promptText="Mô tả chi tiết vật phẩm..." prefRowCount="3" wrapText="true" />

                        <Label text="Giá khởi điểm ($):">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtStartingPrice" promptText="Ví dụ: 1000" />
                    </children>
                </VBox>

                <Label fx:id="lblStatus" textFill="RED" />

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCreateAuction" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150;" text="Tạo Phiên Đấu Giá" />
                    </children>
                </HBox>

                <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 20 0 0 0; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0; -fx-margin-top: 10;">
                    <children>
                        <Label text="Quản lý phiên đấu giá" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="txtRoomIdToClose" promptText="Nhập Mã Phòng (VD: AU00441)" prefWidth="200.0" />
                                <Button mnemonicParsing="false" onAction="#handleCloseAction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Chốt Đơn Bán" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>