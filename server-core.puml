@startuml ServerCore
title Server Core - Runtime and Action Dispatch

top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 55
skinparam ranksep 70
hide members

package "Server Entry" as Entry {
  class AuctionServer
}

package "Connection Runtime" as Runtime {
  class ClientHandler
  class ClientActionContext
  class ClientActionRouter
}

package "Handler Contract" as Contract {
  interface ClientActionHandler
  abstract class AbstractClientActionHandler
}

package "Action Handlers" as Handlers {
  class AuthActionHandler
  class RoomActionHandler
  class SellerActionHandler
  class AdminActionHandler
}

package "Server Services" as Services {
  class AuthService
  class AuctionRoomService
  class PendingAuctionApprovalService
  class ProductDetailService
}

package "Shared Protocol" as Common {
  class Message
  class User
  class AuctionRoom
  class PendingAuctionRequest
}

AuctionServer o-- ClientHandler : active clients
ClientHandler --> ClientActionContext : owns
ClientHandler --> ClientActionRouter : routes request
ClientHandler ..> Message : read / write

ClientActionRouter o-- ClientActionHandler : registered handlers
ClientActionHandler <|.. AbstractClientActionHandler
AbstractClientActionHandler <|-- AuthActionHandler
AbstractClientActionHandler <|-- RoomActionHandler
AbstractClientActionHandler <|-- SellerActionHandler
AbstractClientActionHandler <|-- AdminActionHandler

AuthActionHandler --> AuthService
RoomActionHandler --> AuctionRoomService
RoomActionHandler --> ProductDetailService
SellerActionHandler --> PendingAuctionApprovalService
AdminActionHandler --> PendingAuctionApprovalService

ClientActionContext --> AuthService
ClientActionContext --> AuctionRoomService
ClientActionContext --> PendingAuctionApprovalService

AuthService ..> User
AuctionRoomService ..> AuctionRoom
PendingAuctionApprovalService ..> PendingAuctionRequest
Handlers ..> Message
@enduml
