<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.AuctionController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox fx:id="paneSelectAuction" prefHeight="200.0" prefWidth="100.0" visible="false">

                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="20.0" style="-fx-background-color: #34495e; -fx-padding: 10;">
                            <children>
                                <Label text="Sàn Đấu Giá Trực Tuyến" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>

                                <HBox HBox.hgrow="ALWAYS" />

                                <Label fx:id="lblUsername" text="Xin chào, User" textFill="#f1c40f">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblBalance" text="Số dư: 0 VNĐ" textFill="#2ecc71">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Button fx:id="btnCreateAuction" mnemonicParsing="false" onAction="#openSellerDashboard"
                                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="+ Create Auction" visible="false" managed="false" />

                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="gridAuctions" hgap="20.0" prefWrapLength="200.0" style="-fx-padding: 20;" vgap="20.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <VBox fx:id="paneAuctionRoom" alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #f4f6f9;" visible="false">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleBackToSelection" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="⬅ Rời Phòng" />
                                <Label fx:id="lblAuctionItemName" text="Tên Vật Phẩm" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
                            <children>
                                <Label fx:id="lblCurrentPrice" text="Giá hiện tại: 0 $" textFill="#27ae60">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="txtBidAmount" prefWidth="200.0" promptText="Nhập mức giá bạn muốn đặt ($)" />
                                <Button mnemonicParsing="false" onAction="#handleBid" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="💰 Đặt Giá" />
                                <Button fx:id="btnCloseAuction"
                                        visible="false"
                                        managed="false"
                                        onAction="#handleCloseAuction"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"
                                        text="CHỐT ĐƠN &amp; ĐÓNG PHÒNG" />
                            </children>
                        </HBox>

                        <TextArea fx:id="txtChatLog" editable="false" prefHeight="250.0" prefWidth="760.0" style="-fx-font-family: 'Consolas';" wrapText="true" VBox.vgrow="ALWAYS" />

                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txtChatInput" promptText="Nhập tin nhắn chém gió..." HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#handleSendChat" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Gửi Chat" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="paneForgotPassword" alignment="CENTER" maxWidth="400.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0" visible="false">
                    <children>
                        <Label text="Khôi Phục Mật Khẩu">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtForgotUsername" promptText="Tên đăng nhập" />
                        <PasswordField fx:id="txtForgotNewPassword" promptText="Mật khẩu mới" />
                        <PasswordField fx:id="txtForgotConfirm" promptText="Xác nhận mật khẩu" />
                        <Label fx:id="lblForgotStatus" textFill="RED" />
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleSubmitForgotPassword" style="-fx-background-color: #f1c40f; -fx-text-fill: white; -fx-min-width: 100;" text="Đổi Mật Khẩu" />
                                <Button mnemonicParsing="false" onAction="#showLoginScreen" style="-fx-background-color: transparent; -fx-text-fill: #333;" text="Quay lại" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </VBox>

                <VBox fx:id="paneRegister" alignment="CENTER" maxWidth="400.0" prefHeight="200.0" prefWidth="100.0" spacing="15.0" visible="false">
                    <children>
                        <Label text="Đăng Ký Tài Khoản">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtRegUsername" promptText="Tên đăng nhập" />
                        <PasswordField fx:id="txtRegPassword" promptText="Mật khẩu" />
                        <PasswordField fx:id="txtRegConfirm" promptText="Xác nhận mật khẩu" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Vai trò:" />
                                <ComboBox fx:id="cbRegRole" prefWidth="150.0" promptText="Chọn vai trò" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Label fx:id="lblRegStatus" textFill="RED" />
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleSubmitRegister" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-min-width: 100;" text="Đăng Ký" />
                                <Button mnemonicParsing="false" onAction="#showLoginScreen" style="-fx-background-color: transparent; -fx-text-fill: #333;" text="Quay lại" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </VBox>

                <VBox fx:id="paneLogin" alignment="CENTER" maxWidth="400.0" prefHeight="400.0" prefWidth="300.0" spacing="15.0">
                    <children>
                        <Label text="Đăng Nhập Sàn Đấu Giá">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtUsername" promptText="Tên đăng nhập" text="Adam" />
                        <PasswordField fx:id="txtPassword" promptText="Mật khẩu" text="123456" />
                        <Label fx:id="lblStatus" textFill="RED" />
                        <Button mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-min-width: 200; -fx-font-weight: bold;" text="Đăng Nhập" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#showRegisterScreen" style="-fx-background-color: transparent; -fx-text-fill: #2ecc71;" text="Chưa có tài khoản?" />
                                <Button mnemonicParsing="false" onAction="#showForgotPasswordScreen" style="-fx-background-color: transparent; -fx-text-fill: #e67e22;" text="Quên mật khẩu?" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>