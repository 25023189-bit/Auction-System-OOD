<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="chatbotPanel"
      id="chatbotPanel"
      alignment="TOP_CENTER"
      disable="false"
      managed="true"
      maxHeight="520.0"
      maxWidth="380.0"
      minHeight="520.0"
      minWidth="380.0"
      mouseTransparent="false"
      prefHeight="520.0"
      prefWidth="380.0"
      spacing="0"
      styleClass="chatbot-panel"
      stylesheets="@../css/chatbot-chatting-view.css"
      visible="true"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.feature.controllers.assistant.chatbot.ChatBotController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chatbot-header">
            <children>
                <StackPane minHeight="44.0" minWidth="44.0" prefHeight="44.0" prefWidth="44.0" styleClass="chatbot-avatar">
                    <children>
                        <Label text="AI" styleClass="chatbot-avatar-text" />
                    </children>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="chatbot-title" text="Auction Assistant" />
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <children>
                                <Region minHeight="7.0" minWidth="7.0" prefHeight="7.0" prefWidth="7.0" styleClass="chatbot-status-dot" />
                                <Label styleClass="chatbot-subtitle" text="AI hỗ trợ đấu giá thông minh" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Button fx:id="btnCloseChatbot"
                        id="btnCloseChatbot"
                        onAction="#hideChatbot"
                        styleClass="chatbot-close-button"
                        text="×" />
            </children>
        </HBox>

        <ScrollPane fx:id="chatScrollPane"
                    id="chatScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="chatbot-scroll"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="chatMessages"
                      id="chatMessages"
                      spacing="10"
                      styleClass="chatbot-messages" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="10" styleClass="chatbot-input-bar">
            <children>
                <TextField fx:id="txtChatbotInput"
                           id="txtChatbotInput"
                           promptText="Hỏi về phiên đấu giá, giá thầu, luật đấu..."
                           styleClass="chatbot-input"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSendChatbot"
                        id="btnSendChatbot"
                        onAction="#handleSendChatbotMessage"
                        styleClass="chatbot-send-button"
                        text="Gửi" />
            </children>
        </HBox>
    </children>
</VBox>
