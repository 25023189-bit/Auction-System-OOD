<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<BorderPane fx:id="paneAuctionRoom" prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@../css/bidder-auction-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AuctionController">
    <center>
        <AnchorPane style="-fx-background-color: transparent;">
            <children>
                <VBox spacing="20.0" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="75.0" style="-fx-padding: 0 25;" styleClass="header-transparent">
                            <children>
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="MANAGEMENT SYSTEM" textFill="#bdc3c7" />
                                        <Label text="AUCTION ROOM (BIDDER)" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="20.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER" spacing="8" style="-fx-border-color: #3498db;" styleClass="header-info-box">
                                            <children>
                                            <Label style="-fx-font-size: 18px;" text="⏱" textFill="WHITE" />
                                            <Label fx:id="lblTimer" text="--:--:--" textFill="WHITE">
                                                <font>
                                                    <Font name="System Bold" size="20.0" />
                                                </font>
                                            </Label>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER" spacing="8" style="-fx-border-color: #3498db;" styleClass="header-info-box">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="👥" textFill="WHITE" />
                                                <Label fx:id="lblParticipantCount" text="Participants: 0" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER" spacing="15">
                                            <children>
                                                <VBox alignment="CENTER_RIGHT">
                                                    <children>
                                                        <Label fx:id="lblUsername" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="User: Adam" textFill="WHITE" />
                                                        <Label style="-fx-font-size: 10px;" text="Online" textFill="#2ecc71" />
                                                    </children>
                                                </VBox>
                                                <Button mnemonicParsing="false" onAction="#handleBackToSelection" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="EXIT AUCTION" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <HBox spacing="25.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
                            </padding>
                            <children>
                                <VBox prefWidth="400.0" spacing="15.0" styleClass="info-card">
                                    <children>
                                        <Label text="Product Information" textFill="#2c3e50"><font><Font name="System Bold" size="18.0" /></font></Label>
                                        <Separator prefWidth="200.0" />
                                        <ImageView fitHeight="250.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="true" />
                                        <Label fx:id="lblAuctionItemName" text="Product Name: 4K TV" wrapText="true">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <TextArea fx:id="txtItemDescriptionDisplay" editable="false" prefRowCount="3" style="-fx-control-inner-background: transparent; -fx-background-color: transparent; -fx-text-fill: #7f8c8d;" text="Description: Ultra-sharp display..." wrapText="true" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #fdf2e9; -fx-padding: 15; -fx-background-radius: 10;">
                                            <children>
                                                <Label fx:id="lblCurrentPrice" text="0 $" textFill="#e67e22"><font><Font name="System Bold" size="26.0" /></font></Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="15.0" styleClass="chat-container" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Bid History &amp; Chat" textFill="#2c3e50"><font><Font name="System Bold" size="18.0" /></font></Label>
                                        <LineChart fx:id="priceChart" animated="false" prefHeight="250.0" VBox.vgrow="NEVER">
                                            <xAxis>
                                                <CategoryAxis fx:id="xAxis" label="Thời gian" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis fx:id="yAxis" label="Mức giá ($)" />
                                            </yAxis>
                                        </LineChart>
                                        <TextArea fx:id="txtChatLog" editable="false" VBox.vgrow="ALWAYS" wrapText="true" />

                                        <VBox spacing="10.0">
                                            <children>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <TextField fx:id="txtBidAmount" prefHeight="40.0" promptText="Enter your bid amount..." HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnPlaceBid" minWidth="120.0" onAction="#handleBid" prefHeight="40.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="PLACE BID" />
                                                        <Button fx:id="btnToggleAutoBid" minWidth="100.0" onAction="#toggleAutoBidPanel" prefHeight="40.0" style="-fx-background-color: #f1c40f; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-background-radius: 8;" text="AUTO BID ⚙" />
                                                    </children>
                                                </HBox>

                                                <VBox fx:id="paneAutoBid" managed="false" spacing="10.0" style="-fx-background-color: #fff9c4; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #f1c40f; -fx-border-radius: 8;" visible="false">
                                                    <children>
                                                        <Label style="-fx-font-weight: bold;" text="Cấu hình Tự động Đấu giá (Auto-Bidding)" textFill="#2c3e50" />
                                                        <HBox spacing="10.0">
                                                            <children>
                                                                <VBox HBox.hgrow="ALWAYS">
                                                                    <Label text="Giá tối đa (Max Bid):" textFill="#7f8c8d" />
                                                                    <TextField fx:id="txtMaxBid" promptText="VD: 5000" />
                                                                </VBox>
                                                                <VBox HBox.hgrow="ALWAYS">
                                                                    <Label text="Bước giá (Increment):" textFill="#7f8c8d" />
                                                                    <TextField fx:id="txtAutoBidStep" promptText="VD: 50" />
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                            <Button onAction="#handleCancelAutoBid" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5;" text="Hủy Auto" />
                                                            <Button onAction="#handleSetAutoBid" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Thiết lập &amp; Chạy" />
                                                        </HBox>
                                                    </children>
                                                </VBox>

                                                <HBox spacing="10.0">
                                                    <children>
                                                        <TextField fx:id="txtChatInput" prefHeight="40.0" promptText="Type a message..." HBox.hgrow="ALWAYS" />
                                                        <Button minWidth="120.0" onAction="#handleSendChat" prefHeight="40.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8;" text="SEND CHAT" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
