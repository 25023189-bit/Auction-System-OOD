<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="main-container" stylesheets="@../css/admin-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.AdminController">
    <top>
        <HBox alignment="CENTER" styleClass="admin-header">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <Label text="ADMIN DASHBOARD" textFill="WHITE"><font><Font name="System Bold" size="24.0" /></font></Label>
        </HBox>
    </top>
    <center>
        <TabPane styleClass="admin-tab-pane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="User Management">
                    <VBox spacing="10.0"><padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#loadUsers" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh List" />
                            <Button mnemonicParsing="false" onAction="#handleDeleteUser" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Delete Account" />
                        </HBox>
                        <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="150.0" text="Customer ID" />
                                <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />
                                <TableColumn fx:id="colRole" prefWidth="150.0" text="Role" />
                                <TableColumn fx:id="colBalance" prefWidth="200.0" text="Balance ($)" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Auction Management">
                    <VBox spacing="10.0"><padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#loadAuctions" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh List" />
                            <Button mnemonicParsing="false" onAction="#handleForceDeleteAuction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Force Cancel Auction" />
                        </HBox>
                        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRoomId" prefWidth="120.0" text="Room ID" />
                                <TableColumn fx:id="colRoomName" prefWidth="250.0" text="Item Name" />
                                <TableColumn fx:id="colSeller" prefWidth="150.0" text="Seller" />
                                <TableColumn fx:id="colPrice" prefWidth="150.0" text="Current Price ($)" />
                                <TableColumn fx:id="colBidStep" prefWidth="130.0" text="Bid Step ($)" />
                                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Browse Products">
                    <VBox spacing="10.0"><padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#loadPendingAuctions" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh List" />
                            <Button mnemonicParsing="false" onAction="#handleApprovePendingAuction" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Approve" />
                            <Button mnemonicParsing="false" onAction="#handleRejectPendingAuction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Reject" />
                        </HBox>
                        <TableView fx:id="tablePendingAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPendingRequestId" prefWidth="120.0" text="Request ID" />
                                <TableColumn fx:id="colPendingSellerId" prefWidth="120.0" text="Seller ID" />
                                <TableColumn fx:id="colPendingSellerOrganization" prefWidth="170.0" text="Seller Organization" />
                                <TableColumn fx:id="colPendingItemName" prefWidth="170.0" text="Item Name" />
                                <TableColumn fx:id="colPendingItemDesc" prefWidth="240.0" text="Item Description" />
                                <TableColumn fx:id="colPendingStartingPrice" prefWidth="130.0" text="Starting Price" />
                                <TableColumn fx:id="colPendingMinimumJoinAmount" prefWidth="160.0" text="Minimum Join Amount" />
                                <TableColumn fx:id="colPendingBidStep" prefWidth="100.0" text="Bid Step" />
                                <TableColumn fx:id="colPendingStartTime" prefWidth="170.0" text="Start Time" />
                                <TableColumn fx:id="colPendingDurationMinutes" prefWidth="120.0" text="Duration" />
                                <TableColumn fx:id="colPendingExtensionSeconds" prefWidth="120.0" text="Extension" />
                                <TableColumn fx:id="colPendingSellerReputation" prefWidth="130.0" text="Seller Reputation" />
                                <TableColumn fx:id="colPendingSuccessfulAuctionRate" prefWidth="150.0" text="Success Rate" />
                                <TableColumn fx:id="colPendingAdminCancellationRate" prefWidth="170.0" text="Admin Cancel Rate" />
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Transaction Management">
                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Bid History" />
                        <TableView fx:id="tableBidHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBidAuctionId" prefWidth="120.0" text="Room ID" />
                                <TableColumn fx:id="colBidderId" prefWidth="150.0" text="Bidder" />
                                <TableColumn fx:id="colBidAmount" prefWidth="150.0" text="Bid Amount ($)" />
                                <TableColumn fx:id="colBidTime" prefWidth="150.0" text="Bid Time" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
