<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" styleClass="main-container" stylesheets="@../css/admin-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.account.admin.AdminController">

    <center>
        <VBox spacing="18.0" styleClass="dashboard-shell">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="18.0" />
            </padding>

            <TabPane prefHeight="685.0" prefWidth="1116.0" styleClass="admin-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>

                    <Tab text="User Management">
                        <VBox spacing="16.0" styleClass="content-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">
                                <Label styleClass="section-title" text="User Accounts" />
                                <Button mnemonicParsing="false" onAction="#loadUsers" styleClass="primary-button" text="Refresh List" />
                                <Button mnemonicParsing="false" onAction="#handleDeleteUser" styleClass="danger-button" text="Delete Account" />
                            </HBox>

                            <TableView fx:id="tableUsers" styleClass="premium-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colUserId" prefWidth="150.0" text="Customer ID" />
                                    <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />
                                    <TableColumn fx:id="colRole" prefWidth="150.0" text="Role" />
                                    <TableColumn fx:id="colBalance" prefWidth="200.0" text="Balance ($)" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Auction Management">
                        <VBox spacing="16.0" styleClass="content-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="999.0" spacing="12.0" styleClass="toolbar">
                                <Label styleClass="section-title" text="Live Auction Rooms" />
                                <Button mnemonicParsing="false" onAction="#loadAuctions" styleClass="primary-button" text="Refresh List" />
                                <Button mnemonicParsing="false" onAction="#handleForceDeleteAuction" styleClass="danger-button" text="Force Cancel Auction" />
                            </HBox>

                            <TableView fx:id="tableAuctions" styleClass="premium-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colRoomId" prefWidth="120.0" text="Room ID" />
                                    <TableColumn fx:id="colRoomName" prefWidth="250.0" text="Item Name" />
                                    <TableColumn fx:id="colSeller" prefWidth="150.0" text="Seller" />
                                    <TableColumn fx:id="colPrice" prefWidth="150.0" text="Current Price ($)" />
                                    <TableColumn fx:id="colBidStep" prefWidth="130.0" text="Bid Step ($)" />
                                    <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Browse Products">
                        <VBox spacing="16.0" styleClass="content-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="1078.0" spacing="12.0" styleClass="toolbar">
                                <Label styleClass="section-title" text="Pending Product Approval" />
                                <Button mnemonicParsing="false" onAction="#loadPendingAuctions" styleClass="primary-button" text="Refresh List" />
                                <Button mnemonicParsing="false" onAction="#handleApprovePendingAuction" styleClass="success-button" text="Approve" />
                                <Button mnemonicParsing="false" onAction="#handleRejectPendingAuction" styleClass="danger-button" text="Reject" />
                            </HBox>

                            <TableView fx:id="tablePendingAuctions" styleClass="premium-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colPendingRequestId" prefWidth="120.0" text="Request ID" />
                                    <TableColumn fx:id="colPendingSellerId" prefWidth="120.0" text="Seller ID" />
                                    <TableColumn fx:id="colPendingSellerOrganization" prefWidth="170.0" text="Seller Organization" />
                                    <TableColumn fx:id="colPendingItemName" prefWidth="170.0" text="Item Name" />
                                    <TableColumn fx:id="colPendingItemDesc" prefWidth="240.0" text="Item Description" />
                                    <TableColumn fx:id="colPendingStartingPrice" prefWidth="130.0" text="Starting Price" />
                                    <TableColumn fx:id="colPendingMinimumJoinAmount" prefWidth="160.0" text="Minimum Join Amount" />
                                    <TableColumn fx:id="colPendingBidStep" prefWidth="100.0" text="Bid Step" />
                                    <TableColumn fx:id="colPendingStartTime" prefWidth="170.0" text="Start Time" />
                                    <TableColumn fx:id="colPendingDurationMinutes" prefWidth="120.0" text="Duration" />
                                    <TableColumn fx:id="colPendingExtensionSeconds" prefWidth="120.0" text="Extension" />
                                    <TableColumn fx:id="colPendingSellerReputation" prefWidth="130.0" text="Seller Reputation" />
                                    <TableColumn fx:id="colPendingSuccessfulAuctionRate" prefWidth="150.0" text="Success Rate" />
                                    <TableColumn fx:id="colPendingAdminCancellationRate" prefWidth="170.0" text="Admin Cancel Rate" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <Tab text="Transaction Management">
                        <VBox spacing="16.0" styleClass="content-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>

                            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">
                                <Label styleClass="section-title" text="Bid History" />
                            </HBox>

                            <TableView fx:id="tableBidHistory" styleClass="premium-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colBidAuctionId" prefWidth="120.0" text="Room ID" />
                                    <TableColumn fx:id="colBidderId" prefWidth="150.0" text="Bidder" />
                                    <TableColumn fx:id="colBidAmount" prefWidth="150.0" text="Bid Amount ($)" />
                                    <TableColumn fx:id="colBidTime" prefWidth="150.0" text="Bid Time" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
