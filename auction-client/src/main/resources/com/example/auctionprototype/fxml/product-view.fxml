<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="TOP_CENTER" prefHeight="420.0" prefWidth="780.0" spacing="0.0" styleClass="product-detail-card" stylesheets="@../css/product-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.ProductViewController">
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="card-header-bar">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Label fx:id="lblProductName" styleClass="card-main-title" text="Product Detail Information" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#closeWindow" styleClass="card-close-btn" text="X" />
            </children>
        </HBox>

        <HBox spacing="25.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" styleClass="image-container-wrapper">
                    <children>
                        <ImageView fx:id="imgItem" fitHeight="280.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" styleClass="product-image-view">
                            <image>
                                <Image url="@../images/admin-background.jpg" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>

                <VBox spacing="15.0" styleClass="specs-container" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="live-stats-row">
                            <children>
                                <VBox styleClass="stat-box">
                                    <Label styleClass="stat-label" text="Current Price" />
                                    <Label fx:id="lblStartingPrice" styleClass="stat-value-price" text="16.00$" />
                                </VBox>
                                <VBox styleClass="stat-box">
                                    <Label styleClass="stat-label" text="Number of Bids" />
                                    <Label styleClass="stat-value" text="20" />
                                </VBox>
                                <VBox styleClass="stat-box">
                                    <Label styleClass="stat-label" text="Time Remaining" />
                                    <Label styleClass="stat-value-time" text="3h 15m" />
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="bullet-info-pane">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Circle radius="4.0" styleClass="neon-bullet" />
                                    <Label fx:id="lblDescription" styleClass="info-text-highlight" text="Model: Chronos Elite" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" />
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" styleClass="action-footer-row">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
