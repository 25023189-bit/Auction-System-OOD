<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="350.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.feature.controllers.ProductViewController">
    <children>
        <Label fx:id="lblProductName" text="Đang tải dữ liệu..." wrapText="true" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
            <Label text="Giá khởi điểm:" textFill="#7f8c8d" />
            <Label fx:id="lblStartingPrice" text="--- $" textFill="#e74c3c">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
        </VBox>

        <Label text="Mô tả sản phẩm:" />
        <Label fx:id="lblDescription" prefHeight="100.0" prefWidth="260.0" wrapText="true" alignment="TOP_LEFT" style="-fx-background-color: #f1f2f6; -fx-padding: 10;" />

        <Button mnemonicParsing="false" onAction="#closeWindow" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Đóng" />
    </children>
</VBox>