<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<Button fx:id="btnOpenChatbot"
        id="btnOpenChatbot"
        contentDisplay="GRAPHIC_ONLY"
        maxHeight="72.0"
        maxWidth="72.0"
        minHeight="72.0"
        minWidth="72.0"
        onAction="#showChatbot"
        prefHeight="72.0"
        prefWidth="72.0"
        stylesheets="@../css/icon-chatbot-view.css"
        styleClass="chatbot-open-button"
        text=""
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.auction.client.feature.controllers.assistant.chatbot.ChatBotController">
    <graphic>
        <ImageView fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/bidder_mainLobby/icon_chat.png" />
            </image>
        </ImageView>
    </graphic>
</Button>
